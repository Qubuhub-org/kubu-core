# ==============================================================================
# KUBU CORE DAEMON CONFIGURATION FILE (kubu.conf)
# Default Location:
#   Linux:   ~/.kubu/kubu.conf
#   macOS:   ~/Library/Application Support/Kubu/kubu.conf
#   Windows: %APPDATA%\Kubu\kubu.conf
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. GENERAL DAEMON & NETWORK OPTIONS
# ------------------------------------------------------------------------------
# Run in background as a daemon
daemon=1

# Accept incoming P2P connections from other nodes
listen=1

# P2P listening port (Default: 33874)
port=33874

# Bind to specific network interface (0.0.0.0 binds to all available IPv4 interfaces)
bind=0.0.0.0

# Maximum number of peer connections
maxconnections=125

# ------------------------------------------------------------------------------
# 2. JSON-RPC SERVER SETTINGS
# ------------------------------------------------------------------------------
# Enable JSON-RPC server (required for web portals, wallets, and kubu-cli)
server=1

# Mainnet JSON-RPC port (Default: 33873)
rpcport=33873

# Listen for RPC connections on local interface
rpcbind=127.0.0.1

# Restrict RPC access strictly to localhost (add specific IPs for dedicated RPC nodes)
rpcallowip=127.0.0.1/32

# Number of worker threads allocated to serve HTTP RPC requests
rpcthreads=16

# Timeout for HTTP RPC requests (in seconds)
rpcclienttimeout=900

# ------------------------------------------------------------------------------
# 3. RPC AUTHENTICATION
# ------------------------------------------------------------------------------
# Basic Authentication (Replace with strong generated credentials)
rpcuser=kubu_rpc_admin
rpcpassword=ChangeThisToAStrongUnguessablePassword33873!

# Recommended Production Alternative: HMAC Hash Authentication
# Generate using Bitcoin/Dogecoin Core's rpcauth.py script:
# rpcauth=kubu_rpc_admin:e420b9...$8d1f2...

# ------------------------------------------------------------------------------
# 4. INDEXING & TRANSACTION LOGGING
# ------------------------------------------------------------------------------
# Maintain a full transaction index (Required for searching TxIDs & native handles)
txindex=1

# Keep full block chain state; do not prune historical blocks
prune=0

# ------------------------------------------------------------------------------
# 5. PERFORMANCE & MEMORY TUNING
# ------------------------------------------------------------------------------
# Database cache size in Megabytes (Increase if running on a dedicated node, e.g., 2048)
dbcache=1024

# Maximum memory pool size in Megabytes for unconfirmed transactions
maxmempool=300

# ------------------------------------------------------------------------------
# 6. LOGGING & SECURITY
# ------------------------------------------------------------------------------
# Include timestamps in debug.log output
logtimestamps=1

# Reduce log noise in production (set to 0 unless troubleshooting)
debug=0

# Shrink debug.log on node restart
shrinkdebugfile=1
[database]
server = "127.0.0.1"
port = 33873
enabled = true
ports_open = [ 80, 443, 33873 ]
